<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast-DDS unicast discovery profile for a CLIENT (the UI / galvo_draw host).

  Points discovery straight at the Pi backend by IP, so the ROS graph is found
  over plain unicast UDP with NO multicast. This is what makes "docker compose up"
  reliable on Windows (Docker Desktop) and on lab WiFi that blocks multicast.

  The address below is the Pi over the DIRECT ETHERNET CABLE (Pi eth0 = 10.42.0.1).
  Set the Pi's eth0 with nmcli (NOT `ip addr add`, which NetworkManager wipes) --
  see WINDOWS_CLIENT.md. If you reach the Pi over WiFi/LAN, use the Pi's LAN IP.

  Wire it in with:  FASTRTPS_DEFAULT_PROFILES_FILE=/dds/peers.xml
  (the compose override mounts this file to /dds/peers.xml and sets that env).
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <participant profile_name="client_unicast" is_default_profile="true">
      <rtps>
        <builtin>
          <!-- Only initialPeers: send discovery straight to the Pi over unicast.
               Everything else stays default so the well-known discovery ports and
               locator announcements are computed correctly. -->
          <initialPeersList>
            <!-- Pi backend over the direct ethernet cable -->
            <locator><udpv4><address>10.42.0.1</address></udpv4></locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
