# SCOPIO backend -- which physical instrument is which.
#
#   cp .env.example .env        # .env is gitignored: it describes THIS rig
#   docker compose up -d        # compose reads .env automatically
#
# This is the one place the Pi's hardware wiring is written down. Nothing here
# is a secret (API keys live in secrets/api_keys.json); it is per-machine, which
# is why it is not in git.
#
# Change a value -> `docker compose up -d` again (recreates the containers).
# ---------------------------------------------------------------------------

# ---- Instrument addresses (VISA resource strings) -------------------------
# Leave a line commented out to let the node auto-discover the first USB
# instrument. That is fine with ONE instrument on USB -- with two it is a coin
# flip, so set BOTH explicitly as soon as both are plugged in.
#
# To find the strings, on the Pi:
#   docker compose exec scopio python3 -c \
#     "import pyvisa; print(pyvisa.ResourceManager('@py').list_resources())"
# or, from any machine with the instrument attached:
#   python temperature_test.py --list
#
# USB looks like  USB0::0x1AB1::0x0642::DG1ZA000000000::INSTR
# Ethernet like   TCPIP::192.168.1.50::INSTR
# Do not quote the value and do not put a comment after it on the same line.

# Rigol DG1022Z arbitrary-waveform generator -- drives the galvo mirrors.
#GALVO_RESOURCE=USB0::0x1AB1::0x0642::DG1ZA000000000::INSTR

# Wavelength Electronics TC LAB -- sample temperature controller.
# An ETHERNET unit MUST be named here: pyvisa-py cannot scan the LAN, so
# auto-discovery will never find it.
#TCLAB_RESOURCE=TCPIP::192.168.1.50::INSTR

# ---- Camera frame size (optional) -----------------------------------------
# Passed to the camera service; defaults 640x480.
#CAM_W=640
#CAM_H=480
