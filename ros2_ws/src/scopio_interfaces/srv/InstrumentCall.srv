# Call ANY public method on an instrument driver class living inside a node.
#
# This is the generic "the node owns the whole driver, the client picks what to
# use" surface (galvo_node -> WaveGen, temperature_node -> TCLab). One service
# covers every present and future capability of the instrument, so the ROS
# contract never grows a method-per-service combinatorial API and the node
# stays instrument-agnostic.
#
#   method: "set_setpoint"   args: "[25.0]"                    kwargs: ""
#   method: "apply_sine"     args: "[1000, 2.0]"               kwargs: "{\"channel\": 2}"
#   method: "command"        args: "[\":OUTPut1 ON\"]"         kwargs: ""
#   method: "list_methods"   args: ""                          kwargs: ""
#
# Discoverability: call "list_methods" -- it returns the name, signature and
# docstring of every callable the node exposes, so a client (or an agent) can
# ask the instrument what it can do instead of reading the driver source.
string method    # method name on the driver, or a node meta-method
string args      # JSON array of positional args   ("" == none)
string kwargs    # JSON object of keyword args     ("" == none)
---
bool success
string result    # JSON-encoded return value ("null" when the method returns None)
string error     # empty on success
