# Jump-scan a rectangular region of the sample by stepping the stage across a
# grid of frames (no smooth motion needed -- it jumps frame to frame, knowing
# its global position). Reports the bead count seen at each stop. The DECISION
# of what to do at each frame stays with the external computer; this action
# only executes the scan pattern and reports what it sees.
int32 x_min           # stage steps
int32 x_max
int32 y_min
int32 y_max
int32 step            # steps between adjacent frames
float32 settle_s      # pause before reading beads at each stop
---
# Result
bool success
int32 frames_visited
---
# Feedback
int32 frames_visited
int32 x
int32 y
int32 beads_in_frame
