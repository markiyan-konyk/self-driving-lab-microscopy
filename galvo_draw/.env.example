# Copy this file to .env (which is gitignored) and fill in your Pi.
# Then just: python app.py
# ---------------------------------------------------------------------------

# The microscope (same keys as ui/ and viscosity_agent/).
SCOPIO_URL=http://<pi-ip>:8000
SCOPIO_API_KEY=<key from: python3 ros2_ws/scripts/generate_api_key.py galvo_draw>

# Optional: web UI port (default 8090).
# GALVO_DRAW_PORT=8090
