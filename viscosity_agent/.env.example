# Copy to .env (gitignored) or export these in your shell before running.
# ---------------------------------------------------------------------------

# --- the microscope (same as ui/ and galvo_draw/) ---
SCOPIO_URL=http://<pi-ip>:8000
SCOPIO_API_KEY=<key from ros2_ws/scripts/generate_api_key.py>

# --- the LLM: set ONE of these (provider is auto-detected from whichever
#     key is present; set LLM_PROVIDER only to override the auto-choice) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic          # or: openai   (optional; auto-detected)
# ANTHROPIC_MODEL=claude-opus-4-8 # default flagship
# OPENAI_MODEL=gpt-5.6-sol        # default flagship

# --- the one physical input the agent cannot infer ---
# Microscope calibration in micrometres per pixel. If the gateway already has
# a calibration latched (set via the UI), leave this blank and the agent uses
# it; otherwise the agent will use this value (or prompt for it interactively).
# UM_PER_PX=0.5
